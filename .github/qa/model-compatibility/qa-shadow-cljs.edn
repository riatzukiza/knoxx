{:deps {:aliases [:cljs]}
 :builds
 {:entry
  {:target :esm
   :runtime :node
   :output-dir "dist"
   :modules {:entry {:exports {:runCheckedEmbeddingQa
                              knoxx.backend.extern.live-checked-embedding-qa/run}}}
   :js-options {:js-provider :import
                :keep-as-import #{"@open-hax/openplanner-sdk/config"
                                  "@open-hax/openplanner-sdk/embedding-runtime"}}
   :compiler-options {:output-feature-set :es-next :infer-externs false}}}}
