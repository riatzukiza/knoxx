 :creative-agent-tools-allowed
 ["discord.read" "discord.send" "discord.react" "discord.guilds"
  "discord.channels" "discord.channel.messages" "discord.search" "discord.thread.create"
  "bluesky.timeline" "bluesky.search" "bluesky.thread" "bluesky.profile"
  "bluesky.author.feed" "bluesky.notifications" "bluesky.follows"
  "bluesky.publish" "bluesky.like" "bluesky.repost"
  "memory_search" "memory_session"
  "read" "write" "bash" "music.generate" "image.generate"
  "audio.waveform" "audio.spectrogram" "voice.tts" "agents.spawn"]

 ;; Apply only to the existing reply agent; preserve all unrelated denial
 ;; entries, its persona/model, incoming-message-first task and publish limits.
 ;; These underlying reads also admit shared encounter context at decision time.
 :reply-agent-tools-allowed
 ["discord.send" "discord.read" "discord.react" "agents.spawn"
  "discord.channel.messages" "bluesky.timeline" "memory_search" "memory_session"]
 :reply-tool-denials-to-remove [:bluesky.timeline :memory_search :memory_session]
 :reply-passive-memory-hydration
 {:enabled? true :provider :openplanner :mode :always :k 3}
 :reply-agent-tool-modes
 {:initial "home" :core []
  :modes
  {"home" {:description "Respond promptly to the supplied home-channel event."
           :tools ["discord.read" "discord.send" "discord.react"]}
   "observe" {:description "Read currently permitted Discord or the bound Bluesky timeline when needed."
              :tools ["discord.channel.messages" "bluesky.timeline"]}
   "memory" {:description "Recall currently authorized session/action memory."
             :tools ["memory_search" "memory_session"]}
   "delegate" {:description "Acknowledge an explicit creative request and delegate once to the independent maker."
               :tools ["agents.spawn"]}}}

