# Native (Docker-free) local Knoxx backend. Copy to a private path, chmod 600,
# and fill the three generated secrets with: openssl rand -hex 32
# Start: (cd backend && node --env-file=/path/to/knoxx.env dist/server.js)
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=knoxx
KNOXX_OPENPLANNER_CLIENT_MODE=mongo
KNOXX_PUBLIC_BASE_URL=http://127.0.0.1:8000
KNOXX_BASE_URL=http://127.0.0.1:8000
KNOXX_SESSION_SECRET=<generate>
KNOXX_API_KEY=<generate>
KNOXX_MCP_LOOPBACK_TOKEN=<generate>
KNOXX_API_KEY_USER_EMAIL=system-admin@open-hax.local
KNOXX_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=system-admin@open-hax.local
KNOXX_PRIMARY_ORG_SLUG=local
KNOXX_PRIMARY_ORG_NAME="Local Workspace"
KNOXX_DISABLE_EVENT_RUNTIMES=true
CONTRACTS_DIR=../contracts
KNOXX_CONTRACTS_DIR=../contracts
KNOXX_GENERATED_CONTRACTS_DIR=/tmp/knoxx-local/generated-contracts
KNOXX_PUBLICATION_CONTENT_ROOT=/tmp/knoxx-local/content
WORKSPACE_ROOT=/tmp/knoxx-local/workspace
KNOXX_AGENT_DIR=/tmp/knoxx-local/agent
# Free local providers (Ollama). No Proxx needed for chat with gemma4:e2b.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=gemma4:e2b
EMBED_PROVIDER_BASE_URL=http://127.0.0.1:11434
EMBED_PROVIDER_API_KEY=
# Laptop-sized: native 1024 dims. NOT vector-compatible with qwen3-embedding:8b;
# use a separate database or re-embed before mixing with production data.
EMBED_PROVIDER_MODEL=qwen3-embedding:0.6b
EMBED_PROVIDER_DIMENSIONS=1024
# Optional: Proxx for hosted models, websearch and Blaze media tools.
PROXX_BASE_URL=http://127.0.0.1:8789
